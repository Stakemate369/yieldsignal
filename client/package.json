{
  "name": "yieldsignal-client",
  "version": "1.2.0",
  "description": "x402 client for YieldSignal: yield signal, MOVE/HOLD decision, and four risk reports agents can't get elsewhere — incentive durability, exit capacity, borrow-rate sensitivity and shared exposure. USDC/WETH lending on Base + ETH liquid staking. EIP-712 signed, EAS-attested on-chain.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "x402",
    "yield",
    "defi",
    "base",
    "agent",
    "mcp",
    "risk",
    "exposure",
    "liquidity",
    "lending",
    "apy",
    "staking",
    "aave",
    "compound",
    "morpho",
    "treasury",
    "agent-payments",
    "onchain-data"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stakemate369/yieldsignal.git",
    "directory": "client"
  },
  "homepage": "https://yieldsignal.vercel.app",
  "dependencies": {
    "@x402/fetch": "^2.18.0",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
