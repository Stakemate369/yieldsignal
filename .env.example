# Credenciais CDP PRÓPRIAS deste projeto — gere um par NOVO no portal da CDP,
# NÃO reaproveite as do YieldPilot. Estas 3 variáveis são usadas pelo
# createX402Server() pra provisionar automaticamente a carteira que recebe
# os pagamentos x402 — não existe endereço configurado à mão aqui.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# "development" liquida em base-sepolia (dinheiro de teste) — use isto pra
# ensaiar o fluxo de pagamento ANTES de trocar pra "production" (base mainnet,
# dinheiro real).
X402_ENVIRONMENT=development

# Carteira pessoal (a mesma que você usa no YieldPilot ou outra, sua escolha)
# — único destino permitido pelo comando `npm run withdraw`.
OWNER_WALLET_ADDRESS=

PORT=4021
PRICE_USD=$0.01
# Preço PREMIUM das rotas de decisão (/decision/* e a tool MCP
# get_yield_decision) — a decisão MOVE/HOLD vale mais que o dado bruto. Mesmo
# formato "Money" do x402. Vazio cai no default $0.05.
DECISION_PRICE_USD=$0.05
LOG_LEVEL=info

# Alerta operacional opcional pro dono (mesmo padrão do YieldPilot). Configure
# os DOIS pra ligar: token do bot (@BotFather) e o chat_id do destino. Ambos
# vazios = alerta desligado (no-op). Hoje avisa quando o auto-attest falha
# (ex.: saldo de gas abaixo do piso MIN_GAS_RESERVE_ETH).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Preenchido depois de rodar `npm run register-schema` uma vez (mainnet,
# gasta ETH real de gas) — vazio desliga só `npm run attest`, resto do
# produto funciona normalmente sem isso.
EAS_SCHEMA_UID=

# Protege POST /internal/auto-attest (gatilho de atestação automática — gasta
# ETH real de gas quando dispara). Vazio SEMPRE nega a rota (fail-closed),
# nunca deixa aberta. Configure o mesmo valor no header `Authorization: Bearer
# <valor>` do cron externo (cron-job.org) que chama essa rota periodicamente.
CRON_TRIGGER_SECRET=

# Piso de saldo de ETH abaixo do qual auto-attest se recusa a gastar mais gas
# — protege contra drenar a carteira sozinho. `npm run attest` (manual) não é
# afetado por isso.
MIN_GAS_RESERVE_ETH=0.0005

# --- Funil de uso (GET /usage.json) ---
# Protege a leitura do relatório de uso. Vazio cai pro CRON_TRIGGER_SECRET
# acima; se os dois estiverem vazios, a rota nega sempre (fail-closed). Não é
# dado público: contagem de chamadas é informação de negócio, não produto.
USAGE_READ_SECRET=

# Store durável do contador de uso — qualquer Redis com API REST (Upstash,
# Vercel KV). NÃO precisa configurar estes dois nomes se você conectar um store
# pelo painel da Vercel: a descoberta casa por SUFIXO do nome da variável, então
# o par que a integração injeta (inclusive prefixado, tipo
# UPSTASH_REDIS_REST_KV_REST_API_URL/_TOKEN) é encontrado sozinho. Use estes só
# pra apontar um Redis à mão. Sem nenhum dos dois, o contador vira em-memória
# por instância e /usage.json reporta "durable": false.
USAGE_REDIS_REST_URL=
USAGE_REDIS_REST_TOKEN=

# Teto de eventos de telemetria por dia (default 800). Existe porque o store de
# uso pode compartilhar a instância de Redis com outro projeto — o teto garante
# que uma enxurrada de sondas 402 nunca consuma a cota alheia. Passado o teto, a
# telemetria pausa até virar o dia; o produto continua servindo normalmente.
USAGE_MAX_EVENTS_PER_DAY=800
